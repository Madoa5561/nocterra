# 秘密情報はここに書かない（.env をコミットしない）
# このファイルはテンプレート。実値は .env に置く。

# --- API キー ---
TRIPO=
OPENAI=
DEEPSEEK=
FISH=

# --- アセットパイプラインのコスト制御（プロジェクト独自設定） ---
# true の間は課金対象リクエストを送信しない
ASSET_DRY_RUN=true
# 実課金を許可するか（ユーザーの明示承認があるまで false）
ASSET_AUTO_SPEND=false
# 累計の上限（USD）。超過時は送信前に拒否する
ASSET_MAX_COST_USD=5

# --- サービス別予算（任意） ---
ASSET_MAX_COST_OPENAI_USD=3
ASSET_MAX_COST_TRIPO_USD=2
ASSET_MAX_COST_FISH_USD=1
